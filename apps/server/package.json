{
  "name": "@repo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node webchat-widget/tools/build.ts && node forms-embed/tools/build.ts && node booking-embed/tools/build.ts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "start": "node --import ./dist/instrumentation.js dist/main.js",
    "test:integration": "vitest run --coverage --config vitest.integration.config.js",
    "test:container": "vitest run --config vitest.container.config.js",
    "bench:pages": "vitest run --config vitest.bench.config.js bench/pages.bench.ts",
    "bench:reports": "vitest run --config vitest.bench.config.js bench/reports.bench.ts",
    "load:intake": "vitest run --config vitest.bench.config.js bench/intake.load.ts",
    "load:neighbours": "vitest run --config vitest.bench.config.js bench/neighbours.load.ts",
    "browser:arrival": "vitest run --config vitest.bench.config.js bench/arrival.browser.ts",
    "dev": "tsc -p tsconfig.build.json && node webchat-widget/tools/build.ts && node forms-embed/tools/build.ts && node booking-embed/tools/build.ts && node --env-file-if-exists=../../.env --import ./dist/instrumentation.js dist/main.js"
  },
  "dependencies": {
    "@fontsource-variable/lexend": "catalog:",
    "@fastify/busboy": "catalog:",
    "@fastify/otel": "catalog:",
    "@fastify/static": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/instrumentation-http": "catalog:",
    "@opentelemetry/instrumentation-pg": "catalog:",
    "@opentelemetry/instrumentation-pino": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@repo/commands": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/kernel": "workspace:*",
    "@repo/mail": "workspace:*",
    "@repo/module-ai": "workspace:*",
    "@repo/module-auth": "workspace:*",
    "@repo/module-automation": "workspace:*",
    "@repo/module-calendar": "workspace:*",
    "@repo/module-commerce": "workspace:*",
    "@repo/module-crm": "workspace:*",
    "@repo/module-files": "workspace:*",
    "@repo/module-forms": "workspace:*",
    "@repo/module-messaging": "workspace:*",
    "@repo/module-notifications": "workspace:*",
    "@repo/module-reporting": "workspace:*",
    "@repo/module-sites": "workspace:*",
    "@repo/module-tenancy": "workspace:*",
    "@repo/module-vault": "workspace:*",
    "@repo/storage": "workspace:*",
    "altcha-lib": "catalog:",

{
  "name": "@repo/site-render",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node runtime/tools/build.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p runtime/tsconfig.json && tsc -p runtime/tools/tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@repo/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "axe-core": "catalog:",
    "jsdom": "catalog:",
    "parse5": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

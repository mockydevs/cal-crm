  "operations": {
    "FetchAccount": {
      "method": "GET",
      "path": "/2010-04-01/Accounts/{Sid}.json",
      "sidPattern": "^AC[0-9a-fA-F]{32}$",
      "success": ["200"]
    },
    "ListIncomingPhoneNumber": {
      "method": "GET",
      "path": "/2010-04-01/Accounts/{AccountSid}/IncomingPhoneNumbers.json",
      "query": ["Beta", "FriendlyName", "PhoneNumber", "Origin", "PageSize", "Page", "PageToken"],
      "pageSize": {
        "type": "integer",
        "format": "int64",
        "minimum": 1,
        "maximum": 1000
      },
      "success": ["200"]
    },
    "CreateMessage": {
      "method": "POST",
      "path": "/2010-04-01/Accounts/{AccountSid}/Messages.json",
      "contentTypes": ["application/x-www-form-urlencoded"],
      "required": ["To"],
      "parameters": [
        "AddressRetention",
        "ApplicationSid",
        "Attempt",
        "Body",
        "ContentRetention",
        "ContentSid",
        "ContentVariables",
        "FallbackFrom",
        "ForceDelivery",
        "From",
        "MaxPrice",
        "MediaUrl",
        "MessageIntent",
        "MessagingServiceSid",
        "PersistentAction",
        "ProvideFeedback",
        "RiskCheck",
        "ScheduleType",
        "SendAsMms",
        "SendAt",
        "ShortenUrls",
        "SmartEncoded",
        "StatusCallback",
        "To",
        "TrafficType",
        "ValidityPeriod"
      ],
      "headerParameters": [],
      "success": ["201"]
    }
  },

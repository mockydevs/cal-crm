{
  "name": "@repo/module-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage --config vitest.config.js",
    "test:integration": "vitest run --coverage --config vitest.integration.config.js",
    "test:ollama": "vitest run --config vitest.live.config.js",
    "evals": "node dist/evals/cli.js",
    "evals:stand-in": "vitest run --config vitest.config.js src/reply-draft-evals.test.ts src/extraction-evals.test.ts --update"
  },
  "dependencies": {
    "@repo/commands": "workspace:*",
    "@repo/contracts": "workspace:*",
    "@repo/db": "workspace:*",
    "@repo/kernel": "workspace:*",
    "@repo/module-crm": "workspace:*"
  },
  "devDependencies": {
    "@repo/testing": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}

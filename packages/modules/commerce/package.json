    "@repo/module-messaging": "workspace:*",
    "@repo/module-tenancy": "workspace:*",
    "@repo/storage": "workspace:*",
    "@repo/testing": "workspace:*",
    "@types/node": "catalog:",
    "@types/pdfmake": "catalog:",
    "@vitest/coverage-v8": "catalog:",

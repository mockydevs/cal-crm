{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "pnpm exec vitest run --config vitest.config.js src/autonomy-rules.test.ts src/proposal-rules.test.ts --reporter=dot"
  },
  "coverageAnalysis": "off",
  "mutate": ["src/autonomy-rules.ts", "src/proposal-rules.ts"],
  "ignorePatterns": ["**", "!src/**/*.ts", "!*.json", "!*.js"],
  "concurrency": 4,
  "timeoutMS": 60000,
  "reporters": ["clear-text", "json"],
  "jsonReporter": { "fileName": "reports/mutation/rules.json" },
  "thresholds": { "high": 100, "low": 100, "break": 100 }
}

# Local development settings. `pnpm dev` copies this to .env the first time; .env stays out
# of git. Production settings live in Coolify, not in a file (apps/server/README.md).
#
# An install keeps nothing on its server: it needs an external PostgreSQL 18 with the
# pgvector extension, and S3-compatible storage for uploaded files (install.env.example,
# docs/HOSTING.md). Development stands in for both on this machine: the database below runs
# in Docker from compose.dev.yml, and files go to a local folder unless you set FILES_STORAGE.

# The development database from compose.dev.yml (pgvector/pgvector:pg18). The passwords are
# for this machine only.
POSTGRES_PASSWORD=dev-only
DEV_DB_PORT=54329
DATABASE_OWNER_URL=postgres://crm_owner:dev-only@127.0.0.1:54329/crm
DATABASE_APP_URL=postgres://crm_app:dev-only@127.0.0.1:54329/crm
DATABASE_WORKER_URL=postgres://crm_worker:dev-only@127.0.0.1:54329/crm
DATABASE_AUTH_URL=postgres://crm_auth:dev-only@127.0.0.1:54329/crm

# Signing in. The address is the dashboard's, which passes /api on to the server,
# so session cookies and the API's same-origin check match what the browser uses. The
# secret signs session cookies; this one is for this machine only.
PUBLIC_URL=http://localhost:5173
# Fixed target for the app-only voice relay; combined local roles do not need it.
# This setting alone does not enable calling.
VOICE_WORKER_ORIGIN=
# Optional shared key for the durable limiter of what the public reaches without signing in:
# booking pages and web chat. Empty keeps both disabled.
# Generate a dedicated random key of at least 32 bytes; use the same key on every app instance.
PUBLIC_INTAKE_SECRET=
# Optional: this install's own AI model servers, as host:port pairs separated by commas,
# such as localhost:11434. They are the only private or plain-http addresses an AI
# provider's key may be sent to. Empty allows public https servers only.
AI_LOCAL_SERVERS=
# Optional: Google Calendar for team members. A Google Cloud OAuth client of the
# type "Web application" whose redirect URI is <PUBLIC_URL>/api/v1/integrations/google/callback
# (with this file's PUBLIC_URL: http://localhost:5173/api/v1/integrations/google/callback).
# Both or neither; empty hides Google Calendar. Tests never call Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=dev-only-secret-for-this-machine-only

# The install's own mail (magic links, password resets) goes to Mailpit from
# compose.dev.yml: read it at http://localhost:8025.
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="Bluebird Digital <crm@bluebird.example>"
# After connecting a mailbox, the install operator may use its public ID for this mail.
# The app queues encrypted messages; a running worker opens and sends them. Leave unset
# to use SMTP_URL and MAIL_FROM. Restart the app after changing this selection.
# SYSTEM_MAILBOX=mbx_01h455vb4pex5vsknk084sn02q

# Files: uploads on local disk, under apps/server, and the secret that signs
# download links, for this machine only. To try S3-compatible storage as an install uses
# it, set FILES_STORAGE=s3 and the FILES_S3_ settings (install.env.example lists them).
FILES_DIR=.data/files
FILES_LINK_SECRET=dev-only-files-link-secret-for-this-machine

# The vault: the key that seals providers' passwords and tokens, for this machine
# only. ROLE=all opens secrets, so it holds the private key. A server run with ROLE=app
# would take its public key instead:
# SECRETS_PUBLIC_KEY=1:public-t-e6gRqjLUQ4UM7RYCMR4JA7W9P_LWS0JxazOyop7GE
SECRETS_KEYS=1:private-dev-only-vault-key-not-for-production-use-0

# One process runs the API and the worker; the dashboard (Vite, port 5173) passes /api to it.
ROLE=all
# Only this machine.
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# The install's settings, for compose.yml. Copy this file to install.env, fill
# it in, then run: docker compose --env-file install.env up -d
# Coolify fills most of these itself. Never commit install.env.

# Your agency's name. The first start creates the agency with it.
AGENCY_NAME="Bluebird Digital"

# The address people use, HTTPS. Session cookies and links in emails use it.
PUBLIC_URL=https://crm.example.com

# Fixed worker origin for voice callback relay. For Compose,
# http://worker:3000 is the private target. Empty leaves the relay unconfigured;
# this foundation setting alone does not enable calling.
VOICE_WORKER_ORIGIN=

# Which image to run. The :main tag is the newest build of main.
CRM_IMAGE=ghcr.io/mockydevs/crm:main

# THE DATABASE: set one up before you install. The install needs PostgreSQL 18 with the
# pgvector extension available (the pgvector/pgvector:pg18 image has both). On Coolify,
# add a PostgreSQL database to the same project, choose that image, and keep it private;
# its host name is the name Coolify shows for it. Any other server works if this one can
# reach it on a private network.
DATABASE_HOST=
DATABASE_PORT=5432
# The four roles the install uses. Make each password long and random, such as with:
#   openssl rand -hex 32
# Use letters and digits only: they go into connection strings as they are.
CRM_OWNER_PASSWORD=
CRM_APP_PASSWORD=
CRM_AUTH_PASSWORD=
CRM_WORKER_PASSWORD=
# For the first start only: the server's superuser, such as
#   postgres://postgres:<password>@<DATABASE_HOST>:5432/postgres
# The first start then creates the four roles (with the passwords above), the crm database
# and its extensions. Remove it once the install has started; every later start skips it.
# Without it, create them yourself with packages/db/bootstrap/0001_roles_and_database.sql.
DATABASE_ADMIN_URL=

# Secrets of 32 characters or more: one signs session cookies, the other file links.
AUTH_SECRET=
FILES_LINK_SECRET=

# Signs the public pages: forms, booking pages and the links to quotes and invoices. 32
# characters or more, such as from: openssl rand -hex 32. Left empty, none of them is served.
PUBLIC_INTAKE_SECRET=

# Only with a CDN in front of the server that is set to keep site pages (docs/HOSTING.md,
# "Putting a CDN in front"): how many seconds it may answer for a published page without
# asking this server, 0 to 300. It is also how long the CDN can go on showing a page after
# it was unpublished. Left empty, the CDN asks every time.
SITES_SHARED_CACHE_SECONDS=

# How many rendered site pages each server process keeps in memory, so a visit to a page
# that has not changed renders nothing. Left empty: 500 pages, and never more than 64 MiB.
# 0 keeps none.
SITES_PAGE_CACHE_PAGES=

# FILE STORAGE: uploaded files are kept in S3-compatible storage, never on this server.
# Set up a bucket before you install, such as in Cloudflare R2 (region auto), Amazon S3,
# Backblaze B2 or MinIO, and an access key that may read, write and delete its objects,
# limited to that bucket. For R2 the endpoint is https://<account id>.r2.cloudflarestorage.com
FILES_S3_ENDPOINT=
FILES_S3_REGION=auto
FILES_S3_BUCKET=
FILES_S3_ACCESS_KEY_ID=
FILES_S3_SECRET_ACCESS_KEY=
# true for storage that needs the bucket in the path, not the host name, such as MinIO.
FILES_S3_PATH_STYLE=false
# The largest upload taken, in bytes, up to 1073741824 (1 GiB). The reverse proxy and any
# CDN in front must allow a request body this large, or uploads fail there first.
FILES_MAX_BYTES=26214400
# The most one business's files may add up to, in bytes (5368709120 is 5 GiB). Empty: no limit.
FILES_BUSINESS_QUOTA_BYTES=
# The most campaign emails one agency's businesses send in 24 hours, together. Empty: no limit.
CAMPAIGN_AGENCY_DAILY_LIMIT=
# Google Calendar for team members: a Google Cloud OAuth client of the type
# "Web application", with the redirect URI <PUBLIC_URL>/api/v1/integrations/google/callback.
# Set both or neither; empty hides Google Calendar. docs/HOSTING.md section 5 has the steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The vault's keys, which seal providers' passwords and tokens. Make them with:
#   docker run --rm ghcr.io/mockydevs/crm:main node dist/vault.js new-key 1
# The worker gets SECRETS_KEYS and the app SECRETS_PUBLIC_KEY. Back SECRETS_KEYS up apart
# from the database's backups: without it, no stored secret can be opened.
SECRETS_KEYS=
SECRETS_PUBLIC_KEY=

# Optional: the database's backups (docs/BACKUPS.md), for a Postgres server that doesn't
# back itself up. A database Coolify manages has scheduled backups of its own: turn those
# on instead. Once a day, the backup
# container dumps the whole database to S3-compatible storage and keeps a week. To turn
# them on, set the profile and the storage: an existing bucket, and an access key that may
# read, write and delete its objects. Then check with:
#   docker compose --env-file install.env run --rm backup now
# A backup holds the database only. It does not hold uploaded files, or any secret in this
# file: keep a copy of this file somewhere else, apart from the bucket.
#COMPOSE_PROFILES=backup
#CRM_BACKUP_IMAGE=ghcr.io/mockydevs/crm-backup:main
# The storage's address, such as https://<account id>.r2.cloudflarestorage.com for
# Cloudflare R2, whose region is auto.
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Backups go to <bucket>/<prefix>/<install name>/YYYY/MM/DD/. The install name is
# PUBLIC_URL's host unless you name it, so several installs can share one bucket.
BACKUP_S3_PREFIX=database
BACKUP_INSTALL_NAME=
# When, in UTC, as HH:MM; and how many days of backups to keep.
BACKUP_AT=02:15
BACKUP_RETENTION_DAYS=7
# Optional: an age public key (age1...). Dumps are then encrypted before they leave the
# server, and only the matching private key restores them. Keep that key off this server.
BACKUP_ENCRYPT_TO=

# The install's own mail: sign-in links and password resets.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM="Bluebird Digital <crm@example.com>"
# After connecting a mailbox, optionally set its mbx_ ID and restart the app.
# Keep the bootstrap settings above for recovery; selected delivery requires the worker.
SYSTEM_MAILBOX=

# The reverse proxy's addresses or CIDR ranges, separated by commas, then `cloudflare` once
# Cloudflare's proxy is on (such as 172.18.0.0/16,cloudflare), so the app sees each
# visitor's own address. An install is always behind a proxy that ends HTTPS: left empty,
# every visitor shares one rate limit and one sign-in limit, and the app says so in its log
# at start (docs/HOSTING.md, "The visitor's address").
TRUST_PROXY=

# How much the app and the worker write to their logs: fatal, error, warn, info, debug,
# trace or silent.
LOG_LEVEL=info
# Connections each of the app and the worker keeps to Postgres, 1 to 100 (docs/HOSTING.md,
# "Scaling notes"). Postgres allows 100 in all unless you change it.
DATABASE_POOL_SIZE=10

# Optional: your own AI model servers, as host:port pairs separated by commas, such as
# ollama:11434. They are the only private or plain-http addresses an AI provider key may
# be sent to. Leave it empty to allow public https model servers only.
AI_LOCAL_SERVERS=

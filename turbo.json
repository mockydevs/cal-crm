{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.js",
        "$TURBO_ROOT$/tsconfig.base.json"
      ],
      "passThroughEnv": ["NODE_OPTIONS"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**", "reports/**"]
    },
    "test:integration": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**", "reports/**"],
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*"]
    },
    "i18n:check": {},
    "test:e2e": {
      "dependsOn": ["build"],
      "outputs": ["playwright-report/**", "reports/**", "test-results/**"],
      "env": ["CI"],
      "passThroughEnv": ["PLAYWRIGHT_*"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    }
  }
}
